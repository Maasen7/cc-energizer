local e=peripheral.find("BigReactors-Energizer")
local m=peripheral.find("monitor")
m.setTextScale(2)

local bgc=colors.lightGray
local units={FE=1,KFE=1e3,MFE=1e6,GFE=1e9,TFE=1e12,PFE=1e15,EFE=1e18}

local function parseFE(t)
 local n,u=string.match(t,"([%d%.]+)%s*(%a+)")
 return (tonumber(n) or 0)*(units[u] or 1)
end

local function at(x,y,t,fg,bg)
 m.setCursorPos(x,y)
 m.setTextColor(fg or colors.black)
 m.setBackgroundColor(bg or bgc)
 m.write(t)
end

local function center(y,t,fg,bg)
 local w,_=m.getSize()
 at(math.floor((w-#t)/2)+1,y,t,fg,bg)
end

local function fill(x,y,w,bg)
 at(x,y,string.rep(" ",w),colors.black,bg)
end

local function sci(n)
 if n>=1e12 then return string.format("%.2fT",n/1e12) end
 if n>=1e9 then return string.format("%.2fG",n/1e9) end
 if n>=1e6 then return string.format("%.2fM",n/1e6) end
 if n>=1e3 then return string.format("%.2fK",n/1e3) end
 return tostring(math.floor(n))
end

local function bar(y,pct)
 local w,_=m.getSize()
 local x=6
 local bw=w-10
 local filled=math.floor(bw*pct)

 at(x-1,y,"[",colors.black,bgc)
 for i=1,bw do
  at(x+i-1,y," ",colors.white,i<=filled and colors.lime or colors.gray)
 end
 at(x+bw,y,"]",colors.black,bgc)
end

while true do
 m.setBackgroundColor(bgc)
 m.clear()

 local storedText=e.getEnergyStoredAsText()
 local storedFE=parseFE(storedText)
 local capFE=e.getEnergyCapacity()
 local pct=math.min(storedFE/capFE,1)

 local input=e.getEnergyInsertedLastTick()
 local output=e.getEnergyExtractedLastTick()
 local on=e.getActive()
 local w,h=m.getSize()
 local mid=math.floor(w/2)

 center(1,"/ ENERGIZER \\",colors.blue,bgc)
 at(3,2,string.rep("-",w-4),colors.blue,bgc)

 local status=" STATUS: "..(on and "ONLINE" or "OFFLINE").." "
 local sx=math.floor((w-#status)/2)+1
 fill(sx-2,3,#status+4,colors.black)
 center(3,status,on and colors.lime or colors.red,colors.black)

 center(5,string.format("%.0f%%",pct*100),colors.black,bgc)
 bar(7,pct)
 center(8,storedText.." / "..sci(capFE).." FE",colors.gray,bgc)

 for y=10,12 do at(mid,y,"|",colors.blue,bgc) end

 at(5,10,"IN ->",colors.blue,bgc)
 at(5,11,tostring(input),colors.blue,bgc)
 at(5,12,"FE/t",colors.gray,bgc)

 local ox=w-14
 at(ox,10,"OUT ->",colors.orange,bgc)
 at(ox,11,tostring(output),colors.orange,bgc)
 at(ox,12,"FE/t",colors.gray,bgc)

 local stripW=math.min(w-10,34)
 local stripX=math.floor((w-stripW)/2)+1
 fill(stripX,h,stripW,colors.black)

 at(stripX+4,h,"> START",colors.lime,colors.black)
 at(mid,h,"|",colors.white,colors.black)
 at(mid+4,h,"() STOP",colors.red,colors.black)

 local timer=os.startTimer(0.5)

 while true do
  local ev,_,x,y=os.pullEvent()
  if ev=="timer" then break end

  if ev=="monitor_touch" then
   if y==h and x<mid then
    e.setActive(true)
   elseif y==h and x>mid then
    e.setActive(false)
   elseif x<=2 and y<=1 then
    return
   end
   break
  end
 end
end
